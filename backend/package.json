{
  "name": "homeroom-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint:contract": "npx --yes @redocly/cli@latest lint openapi.yaml",
    "gen:types": "openapi-typescript openapi.yaml -o src/api/schema.d.ts",
    "migrate": "node src/cli.ts migrate",
    "seed": "node src/cli.ts seed",
    "vercel-build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  }
}
