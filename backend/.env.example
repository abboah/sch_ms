# Copy to .env (or export) for local development. Every value has a safe development default.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Leave DATABASE_URL unset to use the embedded database stored in PGLITE_DIR.
# DATABASE_URL=postgres://user:pass@host:5432/homeroom
PGLITE_DIR=.data/pglite

# Development demo: load the demo school on first boot, and pin "now" so its dates line up.
SEED_DEMO=true
DEMO_NOW=2026-10-05T08:00:00Z
DEMO_PASSWORD=password123

# Required in production (the server refuses to start without them):
# JWT_SECRET=<at least 32 random characters>
# PAYMENT_WEBHOOK_SECRET=<at least 16 random characters>
# CORS_ORIGINS=https://app.example.com
# PAYMENT_GATEWAY=paystack
# PAYSTACK_SECRET_KEY=sk_live_...

# Optional: real SMS/push instead of the console/log-only defaults. Opting into a provider
# requires its credentials (checked at boot, in any environment) — see backend/README.md.
# SMS_PROVIDER=twilio               # or hubtel; default is console (logs only, no send)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1...
# HUBTEL_CLIENT_ID=...
# HUBTEL_CLIENT_SECRET=...
# HUBTEL_FROM=...
# PUSH_PROVIDER=fcm                 # default is console (logs only, no send)
# FCM_PROJECT_ID=...
# FCM_CLIENT_EMAIL=...@....iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
